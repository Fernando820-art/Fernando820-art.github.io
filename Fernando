/* Estilos generales */
body {
    font-family: 'Arial', sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f4f9;
    color: #333;
    text-align: center;
}

/* Encabezado */
header {
    background-color: #24292e; /* Color oscuro estilo GitHub */
    color: white;
    padding: 40px 20px;
}

/* Contenedor principal */
main {
    padding: 40px 20px;
}

.contenido {
    background: white;
    max-width: 600px;
    margin: 0 auto;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

/* Botón interactivo */
button {
    background-color: #2ea44f; /* Verde vistoso */
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.3s;
}

button:hover {
    background-color: #22863a;
}

/* Pie de página */
footer {
    margin-top: 40px;
    font-size: 14px;
    color: #777;
}
